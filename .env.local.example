# --- Firebase client config (safe to expose to the browser) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, keep secret) ---
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full private key, keeping it on one line with literal \n for newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# --- Groq (Prince) ---
GROQ_API_KEY=

# --- Vercel Cron ---
# Any random string. Set the same value in Vercel's project env vars;
# Vercel automatically sends it as a Bearer token when it invokes cron routes.
CRON_SECRET=

# --- One-time admin setup script only (scripts/setup-admin.ts) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
